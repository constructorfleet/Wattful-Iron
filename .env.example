# Host-side HTTP port. The application listens on port 3000 inside the container.
HTTP_PORT=3000

# Keep the application local and put a TLS reverse proxy in front of it.
# Set to 0.0.0.0 only when direct network access is intentional and protected.
BIND_ADDRESS=127.0.0.1

# Image used for pull-based deployments. `docker compose up --build` builds locally.
CIRCUITS_IMAGE=ghcr.io/constructorfleet/wattful-iron:latest

# Optional shared bearer token for the MCP endpoint. Leave empty to disable MCP.
# Generate a value with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional shared browser/REST access gate. Leave empty for loopback-only use.
# Generate a value with: openssl rand -hex 32. A configured shared token keeps full
# access, including manufacturing approval, so remove it once accounts are in use.
WORKBENCH_AUTH_TOKEN=

# Set to "users" for per-user accounts with viewer, engineer, and owner roles.
# Leave empty to keep the previous behaviour (open, or gated by the shared token).
AUTH_MODE=
# Where accounts and the session secret are stored. Defaults to an "auth" directory
# beside project storage. Keep it on persistent, private storage.
AUTH_DIR=
# Optional session signing secret, at least 32 bytes. One is generated and persisted
# in AUTH_DIR when this is empty. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Creates the first owner at startup when accounts are enabled and no users exist.
# Remove both afterwards. The password must contain at least 12 characters.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
# Mark session cookies Secure when a TLS-terminating proxy fronts the workbench.
TRUST_PROXY=false

# Isolated project builds use a separate runner service and one ephemeral job
# container per build. Generate the token file before starting Compose.
BUILD_RUNNER_TOKEN_FILE=./.secrets/build-runner-token

# The builder service alone receives this Docker Engine socket. Prefer a
# dedicated rootless Docker daemon for Compose deployments.
RUNNER_DOCKER_SOCKET=/run/user/1000/docker.sock
BUILD_JOB_IMAGE=wattful-iron-build-job:local
BUILD_SANDBOX_RUNTIME=runsc

# Optional JLCPCB/LCSC part index for supplier stock, price, BOM cost, and the
# manufacturing availability check. Leave empty to keep the workbench offline:
# with no value set, it makes no outbound supplier requests and reports those
# features as not configured. The public tscircuit mirror is
# https://jlcsearch.tscircuit.com, or point this at your own instance.
COMPONENT_SOURCING_URL=
COMPONENT_SOURCING_TIMEOUT_MS=8000

# Project revision history is committed to a Git repository beside each project.
# Set to false to keep only the bounded local snapshots instead. The container
# image installs git; without it the workbench falls back to snapshots anyway.
GIT_HISTORY=true

# Traefik overlay (docker-compose.traefik.yml). WORKBENCH_HOST is required when
# that overlay is used; the rest have defaults. The overlay expects an existing
# Traefik instance on the named external network.
WORKBENCH_HOST=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
